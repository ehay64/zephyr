#include <mem.h>

/*
 * Give the system RAM an alias, as with a TCM that other bus masters reach
 * at a different address. The alias is never accessed, so it can sit in
 * unmapped address space.
 */
&sram0 {
	reg = <0x20000000 DT_SIZE_K(64)>, <0x60000000 DT_SIZE_K(64)>;
	reg-names = "sram0", "sram0_alias";
};
