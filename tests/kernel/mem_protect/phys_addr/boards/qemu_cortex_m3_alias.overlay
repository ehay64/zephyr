#include <mem.h>

/*
 * Give the system RAM an alias, as with a TCM that other bus masters reach
 * at a different address. The alias is never accessed, so it can sit in
 * unmapped address space.
 */
&sram0 {
	compatible = "zephyr,memory-region", "mmio-sram";
	zephyr,memory-region = "SRAM0";
	zephyr,memory-alias = <&sram0_alias>;
};

/ {
	sram0_alias: memory@60000000 {
		compatible = "mmio-sram";
		reg = <0x60000000 DT_SIZE_K(64)>;
	};
};
